DATABASE_URL=postgresql+asyncpg://lexpro:<password>@localhost:5435/lexprodb
# development | staging | production
ENVIRONMENT=development
# At least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEBUG=true
# Dev-only destructive endpoints (/api/v1/admin/*)
ENABLE_ADMIN_ROUTES=false
CORS_ORIGINS=["http://localhost:3000"]

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ENCRYPTION_KEYS_OLD=

# LexPro Managed R2 (default storage for all non-Enterprise tenants)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=lexpro-documents
R2_TOKEN=your-cloudflare-api-token
