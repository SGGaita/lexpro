# Root environment file read by docker-compose.yml.
# Copy to `.env` (never commit it) and fill in real values.

# development | staging | production
ENVIRONMENT=development
DEBUG=false

# PostgreSQL
POSTGRES_USER=lexpro
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_DB=lexprodb

# JWT signing key, at least 32 characters
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Fernet key for encrypting stored storage credentials
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Previous keys (comma-separated) while rotating; leave empty otherwise
ENCRYPTION_KEYS_OLD=

# Dev-only destructive endpoints (/api/v1/admin/*). Ignored unless ENVIRONMENT=development.
ENABLE_ADMIN_ROUTES=false

CORS_ORIGINS=["http://localhost","http://localhost:3000"]
